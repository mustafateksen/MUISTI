          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera erişimi yok. İzin ver ya da iPhone kamerasına geç."
          }
        }
      }
    },
    "No compatible glasses found. Are they on, unfolded and nearby?" : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteensopivia laseja ei löytynyt. Ovatko ne päällä, auki ja lähellä?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumlu gözlük bulunamadı. Açık, katlanmamış ve yakında mı?"
          }
        }
      }
    },
    "No frame (%lld); retrying in %lld s" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
