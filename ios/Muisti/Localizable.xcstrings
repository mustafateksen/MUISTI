      "shouldTranslate" : false
    },
    "Local Network is off for Muisti, so the glasses send photos over slow Bluetooth. Turn it on in Settings › Privacy & Security › Local Network." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikallisverkko on pois päältä Muistilta, joten lasit lähettävät kuvat hitaan Bluetoothin kautta. Laita se päälle kohdassa Asetukset › Tietosuoja ja turvallisuus › Paikallisverkko."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muisti için Yerel Ağ kapalı, bu yüzden gözlük fotoğrafları yavaş Bluetooth ile gönderiyor. Ayarlar › Gizlilik ve Güvenlik › Yerel Ağ'dan aç."
