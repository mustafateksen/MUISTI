    },
    "Okay, I'll stay quiet about that for 30 minutes." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvä, en muistuta siitä 30 minuuttiin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamam, 30 dakika boyunca bu konuda sessiz kalacağım."
          }
