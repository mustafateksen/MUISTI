    "Nothing seen within 100 m of places like home or work is saved to memory. Swipe left to delete." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään, mitä näet 100 metrin säteellä esimerkiksi kodista tai työpaikasta, ei tallenneta muistiin. Poista pyyhkäisemällä vasemmalle."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev veya iş gibi yerlerin 100 m yakınında görülen hiçbir şey hafızaya kaydedilmez. Silmek için sola kaydır."
          }
        }
      }
    },
    "Nothing watched has been seen yet." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
