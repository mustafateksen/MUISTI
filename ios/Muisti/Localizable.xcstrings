    },
    "When you look at a product label" : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun katsot tuoteselostetta"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ürün etiketine baktığında"
          }
        }
      }
    },
    "When you start recording, the signs, numbers and opening hours you see will appear here." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun aloitat tallennuksen, näkemäsi kyltit, numerot ja aukioloajat näkyvät tässä."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayda başladığında gördüğün tabelalar, numaralar ve çalışma saatleri burada görünür."
          }
        }
      }
    },
    "While recording, say the wake word and your question to the glasses (“Muisti, where was the Arduino stand?”). The glasses turn speech into text themselves; the answer plays through their speakers. Or: “Hey Siri, Ask Muisti”." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano tallennuksen aikana laseille herätesana ja kysymyksesi (“Muisti, missä Arduino-osasto oli?”). Lasit muuttavat puheen tekstiksi itse; vastaus kuuluu niiden kaiuttimista. Tai: “Hey Siri, Ask Muisti”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt sırasında uyandırma sözcüğünü ve sorunu gözlüğe söyle (“Muisti, Arduino standı neredeydi?”). Gözlük konuşmayı kendisi yazıya çevirir; yanıt gözlüğün hoparlörlerinden gelir. Ya da: “Hey Siri, Muisti’ye sor”."
          }
        }
      }
    },
