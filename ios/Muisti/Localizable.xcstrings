        }
      }
    },
    "Nothing yet. Say “remind me to…” or “I'm going to…”, or just let Muisti notice things." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä mitään. Sano ”muistuta minua…” tai ”aion…”, tai anna Muistin huomata asioita itse."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz bir şey yok. “Bana … hatırlat” ya da “… yapacağım” de, ya da bırak Muisti kendisi fark etsin."
          }
        }
      }
    },
    "Notice hazards by itself" : {
