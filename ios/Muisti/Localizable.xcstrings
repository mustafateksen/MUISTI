          "stringUnit" : {
            "state" : "new",
            "value" : "I couldn't reach Nemotron, so I can't answer this properly right now. The closest thing I saw, at %1$@, read: %2$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En saanut yhteyttä Nemotroniin, joten en voi vastata tähän kunnolla juuri nyt. Lähimmässä näkemässäni kohteessa (%@) luki: %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemotron'a ulaşamadım, bu yüzden şu an düzgün yanıt veremiyorum. Gördüğüm en yakın şeyde (%1$@) şu yazıyordu: %2$@."
          }
        }
      }
    },
    "I didn't see that clearly; here's the closest frame." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En nähnyt sitä selvästi; tässä lähin kuva."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu net göremedim; işte en yakın kare."
          }
        }
      }
    },
    "I'm listening" : {
