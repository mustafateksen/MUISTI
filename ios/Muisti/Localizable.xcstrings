  "strings" : {
    " Switching to adaptive mode saves battery and reduces heat." : {
      "comment" : "Appended after a glasses warning; keep the leading space",
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Mukautuvaan tilaan vaihtaminen säästää akkua ja vähentää lämpenemistä."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Uyarlanabilir moda geçmek pil tasarrufu sağlar ve ısınmayı azaltır."
          }
        }
      }
    },
