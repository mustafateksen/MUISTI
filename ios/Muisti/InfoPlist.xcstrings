    },
    "NSBluetoothPeripheralUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to connect to your glasses."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitaan yhteyden muodostamiseen laseihisi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gözlüğüne bağlanmak için gerekli."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets Muisti know what is next in your day, so it can remind you in time. Only if you turn it on."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kertoo Muistille, mitä päivässäsi on seuraavaksi, jotta se voi muistuttaa ajoissa. Vain jos otat sen käyttöön."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muisti'nin gününde sırada ne olduğunu bilip sana zamanında hatırlatmasını sağlar. Sadece açarsan."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to add an event you asked Muisti to put in your calendar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitaan tapahtuman lisäämiseen, jonka pyysit Muistia lisäämään kalenteriisi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muisti'den takvimine eklemesini istediğin etkinliği eklemek için gerekli."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used as the capture source when your glasses aren't available."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään kuvalähteenä, kun lasisi eivät ole käytettävissä."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gözlüğün kullanılamadığında görüntü kaynağı olarak kullanılır."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets your iPhone find your glasses over Wi-Fi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaa iPhonen löytää lasisi Wi-Fi-verkon kautta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'unun gözlüğünü Wi-Fi üzerinden bulmasını sağlar."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets Muisti remind you when you arrive at a place even when the app is closed. Only if you turn it on."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaa Muistin muistuttaa sinua, kun saavut paikkaan, vaikka sovellus olisi suljettu. Vain jos otat sen käyttöön."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama kapalıyken bile bir yere vardığında Muisti'nin sana hatırlatma yapmasını sağlar. Sadece açarsan."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to save where you saw things and to decide when to capture a frame."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitaan sen tallentamiseen, missä näit asioita, ja sen päättämiseen, milloin kuva otetaan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şeyi nerede gördüğünü kaydetmek ve ne zaman kare yakalanacağına karar vermek için gerekli."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to ask questions by voice."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitaan kysymysten esittämiseen äänellä."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesle soru sormak için gerekli."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to adjust how often frames are captured while you walk, stand still, or ride, to save battery."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitaan kuvien tallennustiheyden säätämiseen, kun kävelet, seisot tai matkustat, akun säästämiseksi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yürürken, dururken veya araçtayken kare yakalama sıklığını ayarlayıp pil tasarrufu sağlamak için gerekli."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to save photos from your memories to your library."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitaan muistojesi kuvien tallentamiseen kirjastoosi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anılarındaki fotoğrafları arşivine kaydetmek için gerekli."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to choose a video to feed the simulated glasses."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitaan videon valitsemiseen simuloiduille laseille."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simüle edilen gözlüğe verilecek videoyu seçmek için gerekli."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to turn your spoken questions into text."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitaan puhuttujen kysymystesi muuttamiseen tekstiksi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli sorularını metne çevirmek için gerekli."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
