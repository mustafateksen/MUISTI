#!/usr/bin/env python3
"""Drive a DEBUG build of Muisti from outside: show it a video or photos as if the glasses saw
them, talk to it, and read what it answered and what it brought up by itself.

The app must be running with  --remote-driver=<port>|<token>  (see ios/docs/REMOTE_DRIVER.md).

Environment:
  MUISTI_DRIVER_TOKEN   the token the app was started with (required; never printed)
  MUISTI_DRIVER_URL     default http://127.0.0.1:8765

Commands:
  state                         what Muisti keeps and where things stand (JSON)
  ask "<question>"              ask like a user; prints the answer, label, evidence
  frame <photo.jpg> [--no-store]  show one photo as what the glasses see now
  video <file.mp4|.mov> [--step 1.0] [--speed 4] [--track track.json] [--motion walking]
                                play a video as the glasses' view (a frame every STEP s of the
                                video, SPEED times faster than real time; 0 = as fast as possible)
                                The file is uploaded to the app.
  evidence <record id> <out.jpg>  save the stored (blurred) frame of a memory record
  events [--since N] [--all]    what Muisti said or kept to itself since entry N
  wait [--timeout 180]          until the video is fed and every frame is processed
  location <lat> <lon> [--course DEG] [--speed M/S]
  motion <stationary|walking|running|cycling|automotive>
  reply <yes|no|not_now>        answer Muisti's pending question
  tick                          let the agent look at the clock and position now
  chat                          the conversation as the app shows it
  chat-clear                    start a new conversation
  memories [--limit 30]         the newest memories (id, title, time, text)
  delete-memory <id>            delete one memory
  forget <minutes>              forget the last N minutes
  intent <id> done|remove       finish or remove a reminder (ids are in `state`)
  rule <id> on|off|delete       a safety rule (ids are in `state`)
  settings [key=value ...]      assistant switches: assistant, noticing, navigation, people, map_search,
                                evening_summary, safety_auto (true/false); spoken_per_day, minutes_apart,
                                quiet_from, quiet_to (numbers). Without arguments: prints them
  screen ask|memory|safety|notes|back   what the phone shows (for a screen recording)
  reset --yes                   delete all memories, rules and notes in the app

Stage (you decide everything the screen shows and says; no model is called):
  stage-upload <photo> [--name NAME] [--raw]
                                put a picture in the app; prints its file name (NAME.jpg). Faces and
                                plates are masked as on every frame; --raw keeps it untouched
  stage-turn --answer "<text>" [--question "<text>"] [--label seen|not_seen|unsure|chat]
             [--evidence ID,ID] [--images a.jpg,b.jpg] [--live a.jpg] [--title "<text>"]
             [--note "<text>"] [--lang en] [--heard SECONDS] [--think SECONDS] [--silent]
                                one whole turn: the question appears word by word in the listening
                                view, Muisti thinks, the answer is shown and read aloud. Without
                                --question Muisti speaks first (--title is its heading)
  stage-memory <uploaded.jpg> [--name ..] [--kind shop] [--caption ..] [--text "<sign text>"]
               [--street ..] [--area ..] [--minutes-ago N | --at "yyyy-MM-dd HH:mm"] [--lat .. --lon ..]
                                write a memory exactly as given; prints its id (for --evidence)
  stage-view <uploaded.jpg>     the picture shown as the camera's view
  stage-phase idle|listening|thinking|speaking ["<words on screen>"]
  stage-status recording|off|real [--battery 82]   the status island at the top
  stage-clear                   empty the conversation on screen
  stage-play <script.json>      run a list of the steps above in order (see the docs)
"""
import json, os, sys, urllib.request, urllib.error

BASE = os.environ.get("MUISTI_DRIVER_URL", "http://127.0.0.1:8765").rstrip("/")
TOKEN = os.environ.get("MUISTI_DRIVER_TOKEN", "")
STATE_FILE = os.path.expanduser("~/.muisti-drive-last-event")


def call(method, path, body=None, raw=None, content_type="application/json", timeout=600):
    if not TOKEN:
        sys.exit("MUISTI_DRIVER_TOKEN is not set")
    data = raw if raw is not None else (json.dumps(body).encode() if body is not None else None)
    request = urllib.request.Request(BASE + path, data=data, method=method)
    request.add_header("Authorization", "Bearer " + TOKEN)
    if data is not None:
        request.add_header("Content-Type", content_type)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.loads(response.read() or b"{}")
    except urllib.error.HTTPError as error:
        try:
            return {"http_error": error.code, **json.loads(error.read() or b"{}")}
        except Exception:
            return {"http_error": error.code}
    except urllib.error.URLError as error:
        sys.exit(f"cannot reach the app at {BASE}: {error.reason} (is it running with --remote-driver?)")


def option(args, name, default=None, cast=str):
    if name in args:
        index = args.index(name)
        value = cast(args[index + 1])
        del args[index:index + 2]
        return value
    return default


def flag(args, name):
    if name in args:
        args.remove(name)
        return True
    return False


def show(result):
    print(json.dumps(result, ensure_ascii=False, indent=2))


def print_events(result):
    for e in result.get("events", []):
        line = f"#{e['id']} {e['at'][11:19]} [{e['level']}] {e['source']}/{e['topic']}: {e['text']}"
        if e.get("reason"):
            line += f"   ({e['reason']})"
        print(line)
    return result.get("last", 0)


def stage_upload(path, name=None, raw=False):
    with open(path, "rb") as handle:
        data = handle.read()
    query = "?" + "&".join(filter(None, [f"name={name}" if name else "", "raw=1" if raw else ""])) if (name or raw) else ""
    return call("POST", "/stage/upload" + query, raw=data, content_type="image/jpeg")


def stage(what, args):
    """One stage step from command-line arguments."""
    if what == "upload":
        name, raw = option(args, "--name"), flag(args, "--raw")
        return stage_upload(args[0], name, raw)
    if what == "turn":
        body = {"answer": option(args, "--answer", "")}
        for key, name in (("question", "--question"), ("label", "--label"), ("title", "--title"), ("note", "--note"),
                          ("language", "--lang"), ("live_image", "--live")):
            value = option(args, name)
            if value is not None:
                body[key] = value
        for key, name in (("heard_seconds", "--heard"), ("think_seconds", "--think")):
            value = option(args, name, cast=float)
            if value is not None:
                body[key] = value
        evidence, images = option(args, "--evidence"), option(args, "--images")
        if evidence:
            body["evidence_ids"] = [int(x) for x in evidence.split(",")]
        if images:
            body["images"] = images.split(",")
        if flag(args, "--silent"):
            body["speak"] = False
        return call("POST", "/stage/turn", body)
    if what == "memory":
        body = {}
        for key, name in (("name", "--name"), ("kind", "--kind"), ("caption", "--caption"), ("text", "--text"),
                          ("street", "--street"), ("area", "--area"), ("at", "--at"), ("phone", "--phone"), ("hours", "--hours")):
            value = option(args, name)
            if value is not None:
                body[key] = value
        for key, name in (("minutes_ago", "--minutes-ago"), ("lat", "--lat"), ("lon", "--lon")):
            value = option(args, name, cast=float)
            if value is not None:
                body[key] = value
        body["image"] = args[0]
        return call("POST", "/stage/memory", body)
    if what == "view":
        return call("POST", "/stage/view", {"image": args[0]})
    if what == "phase":
        return call("POST", "/stage/phase", {"phase": args[0], **({"text": args[1]} if len(args) > 1 else {})})
    if what == "status":
        battery = option(args, "--battery", cast=int)
        return call("POST", "/stage/status", {"glasses": args[0], **({"battery": battery} if battery else {})})
    if what == "clear":
        return call("POST", "/stage/clear", {})
    if what == "play":
        import time
        folder = os.path.dirname(os.path.abspath(args[0]))
        with open(args[0]) as handle:
            steps = json.load(handle)
        ids, last = {}, {}
        for number, step in enumerate(steps, 1):
            step = dict(step)
            do = step.pop("do", "wait" if "wait" in step else None)
            if do == "wait":
                time.sleep(float(step["wait"]))
                continue
            if do == "upload":
                last = stage_upload(os.path.join(folder, step["file"]), step.get("name"), step.get("raw", False))
            elif do == "screen":
                last = call("POST", "/screen", {"show": step["show"]})
            elif do in ("turn", "memory", "view", "phase", "status", "clear"):
                # "evidence": ["jacket"] names memories made earlier in this script with "as": "jacket".
                if "evidence" in step:
                    step["evidence_ids"] = [ids[name] for name in step.pop("evidence")]
                remember = step.pop("as", None)
                last = call("POST", "/stage/" + do, step)
                if remember and "id" in last:
                    ids[remember] = last["id"]
            else:
                sys.exit(f"step {number}: unknown \"do\": {do}")
            if "error" in last or "http_error" in last:
                sys.exit(f"step {number} ({do}) failed: {last}")
            print(f"{number:>2} {do}: ok", flush=True)
        return {"played": len(steps)}
    sys.exit(f"unknown stage command stage-{what}; run with --help")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    command, args = args[0], args[1:]
    if command == "state":
        show(call("GET", "/state"))
    elif command == "ask":
        result = call("POST", "/ask", {"text": " ".join(args)})
        if "answer" not in result:
            show(result)
            return
        print(f"[{result['label']}] {result['answer']}")
        for e in result.get("evidence", []):
            print(f"   evidence #{e['id']} {e['title']} ({e['seen_at']}) {e['frame']}")
        print(f"   {result['latency_ms']} ms" + (" · looked through the glasses" if result.get("looked_live") else "")
              + (" · expects a reply" if result.get("expects_reply") else ""))
        if "--trace" in sys.argv:
            print("   " + result.get("trace", ""))
    elif command == "frame":
        store = not flag(args, "--no-store")
        with open(args[0], "rb") as handle:
            show(call("POST", "/frame" + ("" if store else "?store=0"), raw=handle.read(), content_type="image/jpeg"))
    elif command == "video":
        step = option(args, "--step", 1.0, float)
        speed = option(args, "--speed", 4.0, float)
        track_file = option(args, "--track")
        motion = option(args, "--motion")
        flag(args, "--upload")
        upload = not flag(args, "--by-path")   # by path only works when the app can read this Mac's files
        path = os.path.abspath(args[0])
        if upload:
            import urllib.parse
            query = f"?step={step}&speed={speed}" + (f"&motion={motion}" if motion else "")
            if track_file:
                query += "&track=" + urllib.parse.quote(json.dumps(json.load(open(track_file))))
            with open(path, "rb") as handle:
                kind = "video/quicktime" if path.lower().endswith(".mov") else "video/mp4"
                show(call("POST", "/video" + query, raw=handle.read(), content_type=kind))
        else:
            body = {"path": path, "step": step, "speed": speed}
            if motion:
                body["motion"] = motion
            if track_file:
                body["track"] = json.load(open(track_file))
            show(call("POST", "/video", body))
    elif command == "evidence":
        if not TOKEN:
            sys.exit("MUISTI_DRIVER_TOKEN is not set")
        request = urllib.request.Request(BASE + f"/evidence?id={int(args[0])}")
        request.add_header("Authorization", "Bearer " + TOKEN)
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                open(args[1], "wb").write(response.read())
            print("saved", args[1])
        except urllib.error.HTTPError as error:
            sys.exit(f"no frame for record {args[0]} ({error.code})")
    elif command == "events":
        since = option(args, "--since", None, int)
        if since is None:
            since = 0 if flag(args, "--all") or not os.path.exists(STATE_FILE) else int(open(STATE_FILE).read() or 0)
        last = print_events(call("GET", f"/events?since={since}"))
        open(STATE_FILE, "w").write(str(last))
    elif command == "wait":
        timeout = option(args, "--timeout", 180, float)
        show(call("GET", f"/wait-idle?timeout={timeout}", timeout=timeout + 30))
    elif command == "location":
        course = option(args, "--course", None, float)
        speed = option(args, "--speed", None, float)
        body = {"lat": float(args[0]), "lon": float(args[1])}
        if course is not None:
            body["course"] = course
        if speed is not None:
            body["speed"] = speed
        show(call("POST", "/location", body))
    elif command == "motion":
        show(call("POST", "/motion", {"kind": args[0]}))
    elif command == "reply":
        show(call("POST", "/reply", {"answer": args[0]}))
    elif command == "tick":
        show(call("POST", "/tick", {"review": flag(args, "--review")}))
    elif command == "log":
        body = {"object": args[0], "value": args[1], "kind": option(args, "--kind", "action")}
        at = option(args, "--at", None)
        if at:
            body["at"] = at
        show(call("POST", "/log", body))
    elif command == "habits":
        for line in call("GET", "/habits").get("habits", []):
            print(line)
    elif command == "chat":
        for turn in call("GET", "/chat").get("turns", []):
            who = "Muisti (by itself)" if turn.get("by_muisti") else "you"
            if not turn.get("by_muisti"):
                print(f"you: {turn['question']}")
            print(f"{'Muisti' if not turn.get('by_muisti') else who}: {turn['answer']}")
    elif command == "chat-clear":
        show(call("POST", "/chat/clear", {}))
    elif command == "memories":
        limit = option(args, "--limit", 30, int)
        for m in call("GET", f"/memories?limit={limit}").get("memories", []):
            where = f" · {m['street']}" if m.get("street") else ""
            print(f"#{m['id']} {m['seen_at'][11:19]} {m['title']}{where}")
    elif command == "delete-memory":
        show(call("POST", "/memory/delete", {"id": int(args[0])}))
    elif command == "forget":
        show(call("POST", "/forget", {"minutes": int(args[0])}))
    elif command == "intent":
        show(call("POST", "/intent", {"id": args[0], "action": args[1] if len(args) > 1 else "done"}))
    elif command == "rule":
        show(call("POST", "/rule", {"id": args[0], "action": args[1] if len(args) > 1 else "on"}))
    elif command == "settings":
        body = {}
        for pair in args:
            key, _, value = pair.partition("=")
            body[key] = True if value in ("true", "on", "1") else False if value in ("false", "off", "0") else float(value)
        show(call("POST", "/settings", body))
    elif command == "screen":
        show(call("POST", "/screen", {"show": args[0]}))
    elif command.startswith("stage-"):
        show(stage(command[6:], args))
    elif command == "reset":
        if "--yes" not in args:
            sys.exit("this deletes everything in the app; add --yes")
        show(call("POST", "/reset", {"confirm": "yes"}))
        if os.path.exists(STATE_FILE):
            os.remove(STATE_FILE)
    else:
        sys.exit(f"unknown command {command}; run with --help")


if __name__ == "__main__":
    main()
